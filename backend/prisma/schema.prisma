//  use prisma-8

enum UserRole {
  CUSTOMER
  OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
}

enum AuthProvider {
  GOOGLE
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String?         @unique
  phone        String?         @unique
  passwordHash String
  role         UserRole        @default(CUSTOMER)
  status       UserStatus      @default(ACTIVE)


  session      UserSession[]
  addresses    Address[]
  identities   UserIdentity[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}


model Address{
  id           String    @id @default(uuid())
  userId       String

  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String

  isDefault    Boolean   @default(false)

  user         User     @relation(fields:[userId], refrences:[id], onDelete:Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([userId])

}
  

model UserSession {
  id               String     @id @default(uuid())
  userId           String


  refreshTokenHash String     @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?


  user             User      @relation(fields:[userId], refrences:[id], onDelete:Cascade)

  createdAt        DateTime   @default(now())
  @@index([userId])
}


model OtpVerification{
  id         String      @id @default(uuid())

  identifier String
  otpHash    String
  purpose    OtpPurpose


  expiresAt  DateTime
  attempts   Int         @default(0)
  verifiedAt DateTime?


  createdAt  DateTime    @default(now())

  @@index([identifier, purpose])
}

model UserIdentity{
  id                String        @id @default(uuid())
  userId            String

  provider          AuthProvider
  providerAccountId String

  user              User         @relation(fields:[userId], refrences:[id], onDelete = Cascade)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([provider, providerAccountId])
  @@inddex([userId])
}

model SigupAttempts {
  id           String    @id @default(uuid())

  name         String
  email        String?
  phone        String?
  passwordHask String

  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([phone])
}





//product catalog

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

}
enum ProdcutCategory {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProdcutMediaType {
  IMAGE
  VIDEO
  MODEL_3D
}


model Category{
  id             String            @id @default(uuid())
  name           String
  slug           String
  description    String
  status         CategoryStatus    @default(ACTIVE)
  sortOrder      Int               @default(0)

  // self refrencing herarchy
  parentId       String?
  parent         Category?        @relation("CategoryHierarchy", fields:[parentID],refrences:[id], onDelete:Restrict)

  children       Category[]       @relation("CategoryHierarchy")
  products       Prodcut[]
  prodcutVarient ProductVariant[]

}

model SubCategory {
  id         String    @id @default(uuid())
  name       String
  type       String


  categories Category @relation(fields:[categoryId],refrences:[id] )
}

model Prodcut{
  id         String    @id @default(uuid())

  name       String
  type       String
  category   Category @relation(fields:[categoryId], refrences:[id])
  slug
  productUrl String    @unique
}

model ProductVariant{
  id           String   @id @default(uuid())

  name         String
  color        String
  size         String
  sku          String
  price
  availability String
  gsm          String

  product      Product @relation(feilds:[productId], refrences:[id])
}
  

model Customization {
  id             String           @id @default(uuid())
  text           String
  customizeUrl   String
  position       String
  rotation       String
  scale          String
  color          String
  configurations Configuration[]
}

model Configuration {

}

